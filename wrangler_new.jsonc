{
  "name": "meowzshop",
  "main": "./_worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meowz-store",
      "database_id": "55df2f8e-3784-4b63-9bda-6de2b0e63303"
    }
  ]
}
